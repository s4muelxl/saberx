# Configurações do Supabase para Produção e Local
# Obtenha estas credenciais no painel do seu projeto Supabase em Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Quando vazio ou não configurado, o sistema entrará automaticamente no Modo Demonstração
# com dados isolados locais (organização Demo, produtos reais da planilha e fornecedores).
